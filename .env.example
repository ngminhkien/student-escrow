ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__StudentEscrow=Server=.\MINHKIEN1;Database=StudentEscrowDb;Integrated Security=True;Encrypt=False;Connect Timeout=5
Jwt__SigningKey=replace-with-a-random-local-key-at-least-32-bytes
# Base64 of 32 random bytes for encrypting custodial wallet keys. Development creates .runtime/custodial-master.key when unset.
CustodialWallet__MasterKey=
# Simulated deposit gateway. It credits balances without real money, so the API refuses to start with it outside Development.
Payments__MockEnabled=true
# Base64 of at least 32 random bytes for signing payment webhooks. Development creates .runtime/payment-webhook.key when unset.
Payments__WebhookSecret=
